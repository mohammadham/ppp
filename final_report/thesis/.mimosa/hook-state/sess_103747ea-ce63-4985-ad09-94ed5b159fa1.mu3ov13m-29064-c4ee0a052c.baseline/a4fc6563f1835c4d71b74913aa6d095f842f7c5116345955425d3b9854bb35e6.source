"""Explicit source precedence; never merge alternative drafts silently."""
CHAPTERS = {
    1: ['Introduction', 'Problem_Statement', 'Objectives', 'Questions_Hypotheses', 'Innovations', 'Significance', 'Scope', 'Definitions', 'Structure'],
    2: ['Introduction', 'Theoretical_Foundations', 'Literature_Review', 'Synthesis_Research_Gap'],
    3: ['Introduction', 'Architecture_Dataflow', 'UNet_KeyGen', 'Hyperchaos_5D', 'Zigzag_DNA', 'Saliency_Steganography', 'Complexity_Edge'],
    4: ['Introduction', 'Datasets', 'Evaluation_Metrics', 'Entropy_Histogram', 'Correlation', 'Differential_Attacks', 'Stego_Quality', 'Cyber_Attacks', 'NIST_Tests', 'Comparative_Analysis', 'Summary'],
    5: ['Introduction', 'Synthesis_Findings', 'Hypotheses_Verification', 'Addressing_Gaps', 'Methodological_Contributions', 'Technical_Boundaries', 'Future_Recommendations', 'Final_Remarks'],
}
DRAFTS = {1: 'Chapter1_University_of_Birjand.txt', 2: 'Chapter2_Completed.txt',
          3: 'Chapter3_Full_Completed.txt', 4: 'Chapter4_Full_Completed.txt', 5: 'Chapter5_Completed.txt'}


def source_names(number):
    return [f'{stem}_Chapter{number}.txt' for stem in CHAPTERS[number]]