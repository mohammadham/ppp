        <w:t>دانشکده: دانشکده علوم کامپیوتر</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>رشته: مهندسی کامپیوتر</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>استاد راهنما: ...........................................................</w:t>
      </w:r>
    </w:p>
